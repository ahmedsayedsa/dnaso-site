---
import Base from './Base.astro';
import { formatDate, readingMinutes, categoryFor } from '../lib/site';

interface TocItem {
  slug: string;
  text: string;
}

interface RelatedItem {
  slug: string;
  title: string;
  description: string;
  words: number;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  updatedDate?: Date;
  keywords?: string[];
  lede: string;
  toc: TocItem[];
  related: RelatedItem[];
  wordCount: number;
  heroImage?: string;
  faq?: Array<{ question: string; answer: string }>;
}

const { title, description, slug, pubDate, updatedDate, keywords, lede, toc, related, wordCount, heroImage, faq } = Astro.props;
const canonical = `https://www.dnaso.com${Astro.url.pathname}`;
const category = categoryFor(slug);
const minutes = readingMinutes(wordCount);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: 'Mike Donovan',
    jobTitle: 'Licensed Electrician & Homeowner',
    description: 'Mike is a licensed electrician with 18 years in residential electrical work across the Midwest. He's installed over 200 standby generators, troubleshot everything from dead portables to fried transfer switches, and runs his own home on a 18kW standby. He writes the way he talks on a job site — straight, practical, no sales pitch.',
    url: 'https://www.dnaso.com/about/',
  },
  publisher: { '@type': 'Organization', name: 'Dnaso', url: 'https://www.dnaso.com' },
  mainEntityOfPage: canonical,
};

const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.dnaso.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://www.dnaso.com/#guides' },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};
---

<Base title={title} description={description} canonical={canonical} ogType="article" keywords={keywords}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep" aria-hidden="true">/</span>
      <a href="/#guides">Guides</a><span class="sep" aria-hidden="true">/</span>
      <span aria-current="page">{category}</span>
    </nav>

    <article class="post">
      <span class="tag">{category}</span>
      <h1>{title}</h1>
      <p class="article-lede">{lede}</p>
      <div class="byline">
        <span class="avatar" aria-hidden="true">MD</span>
        <span>By Mike Donovan</span>
        <span class="dot" aria-hidden="true"></span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="dot" aria-hidden="true"></span>
        <span>{minutes} min read</span>
        {updatedDate && (
          <>
            <span class="dot" aria-hidden="true"></span>
            <span>Updated {formatDate(updatedDate)}</span>
          </>
        )}
      </div>

      {heroImage && (
        <figure class="hero-image">
          <img src={heroImage} alt={title} loading="eager" fetchpriority="high" />
        </figure>
      )}

      {toc.length > 0 && (
        <nav class="toc" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose">
        <slot />
      </div>

      {faq && faq.length > 0 && (
        <section class="faq" aria-label="Frequently asked questions">
          <h2>Frequently asked questions</h2>
          {faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </section>
      )}


      <aside class="author-box" aria-label="About the author">
        <div class="author-header">
          <span class="avatar author-avatar" aria-hidden="true">MD</span>
          <div>
            <strong>Mike Donovan</strong>
            <span class="author-role">Licensed Electrician & Homeowner</span>
          </div>
        </div>
        <p>Mike is a licensed electrician with 18 years in residential electrical work across the Midwest. He's installed over 200 standby generators, troubleshot everything from dead portables to fried transfer switches, and runs his own home on a 18kW standby. He writes the way he talks on a job site — straight, practical, no sales pitch.</p>
      </aside>
    </article>

    {related.length > 0 && (
      <section class="related" aria-label="Related guides">
        <h2>Keep reading</h2>
        <p>More practical guides from Dnaso:</p>
        <div class="grid">
          {related.map((r) => (
            <a class="card" href={`/articles/${r.slug}/`}>
              <span class="tag">{categoryFor(r.slug)}</span>
              <h3>{r.title}</h3>
              <p>{r.description}</p>
              <div class="card-meta">
                <span>{readingMinutes(r.words)} min read</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
