---
import { getCollection } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// Table of contents from h2 headings only
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ slug: h.slug, text: h.text }));

// Lede: first real paragraph of the markdown body (layout-level extraction, content untouched)
const rawBody = entry.body ?? '';
const lede =
  rawBody
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .find((p) => p.length > 40 && !p.startsWith('#') && !p.startsWith('<') && !p.startsWith('!') && !p.startsWith('>')) ?? entry.data.description;

const wordCount = rawBody.split(/\s+/).filter(Boolean).length;

const all = await getCollection('articles');
const related = all
  .filter((a) => a.slug !== entry.slug)
  .sort((a, b) => (a.slug === 'complete-home-backup-power-guide' ? -1 : b.slug === 'complete-home-backup-power-guide' ? 1 : 0))
  .slice(0, 3)
  .map((a) => ({
    slug: a.slug,
    title: a.data.title,
    description: a.data.description,
    words: (a.body ?? '').split(/\s+/).filter(Boolean).length,
  }));
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.slug}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  keywords={entry.data.keywords}
  lede={lede}
  toc={toc}
  related={related}
  wordCount={wordCount}
  heroImage={entry.data.heroImage}
>
  <Content />
</Article>
